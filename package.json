{
  "name": "@pmndrs/3d-2d-nav",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gltfjsx": "gltfjsx src/nav/assets/*.glb --types --keepnames --transform --output src/nav/Nav3D/generated",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-spring/three": "^10.1.2",
    "@react-spring/web": "^10.1.2",
    "@react-three/a11y": "^3.0.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/offscreen": "^0.0.8",
    "@react-three/postprocessing": "^3.1.1",
    "@react-three/uikit": "^1.0.76",
    "@use-gesture/react": "^10.3.1",
    "detect-gpu": "^5.0.70",
    "koota": "^0.6.6",
    "leva": "^0.10.1",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.182.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "gltfjsx": "^6.5.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "three": "~0.182.0"
    }
  }
}
